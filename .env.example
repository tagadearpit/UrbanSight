# Backend
DATABASE_URL=postgresql://urbansight:change-me-local-only@localhost:5432/urbansight
PORT=4173
NODE_ENV=development
DEMO_MODE=true
JWT_SECRET=replace-in-production
CORS_ORIGINS=http://localhost:4173,http://localhost:5173
FRONTEND_URL=http://localhost:4173
WEBSOCKET_URL=ws://localhost:4173/ws
ISSUE_RADIUS_METERS=35

# AI service
AI_SERVICE_URL=http://localhost:8000

# S3-compatible evidence storage (optional for local demo)
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
OBJECT_STORAGE_BUCKET=urbansight-evidence

# Optional assistant provider; keep server-side only
GEMINI_API_KEY=

# Frontend build-time variables for separate Vercel deployment
NEXT_PUBLIC_API_URL=
NEXT_PUBLIC_WS_URL=
DEMO_MODE=false
MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
